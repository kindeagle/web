# YouTube source (channel URL, playlist URL, or single video URL)
YOUTUBE_URL=https://www.youtube.com/@YourChannel/videos

# Spotify for Creators credentials
SPOTIFY_EMAIL=your-email@example.com
SPOTIFY_PASSWORD=your-password

# Download settings
DOWNLOAD_DIR=./downloads

# Browser settings (set to false to see the browser during Spotify automation)
HEADLESS=true

# Anthropic API key (for AI-assisted episode metadata)
ANTHROPIC_API_KEY=sk-ant-...
